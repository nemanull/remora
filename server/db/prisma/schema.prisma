generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WalletStatus {
  CANDIDATE
  SHADOW
  LIVE
  RETIRED
}

enum WalletSource {
  LEADERBOARD
  MANUAL
}

enum Book {
  MAIN
  SHADOW
}

enum FillSource {
  STREAM
  SNAPSHOT
  BACKFILL
}

enum CopyAction {
  OPEN
  INCREASE
  REDUCE
  CLOSE
  FLIP
}

enum Verdict {
  COPY
  SKIP
}

enum OrderPurpose {
  ENTRY
  EXIT
  STOP
  RECONCILE
}

enum OrderStatus {
  SUBMITTED
  FILLED
  PARTIALLY_FILLED
  UNFILLED
  REJECTED
  UNKNOWN
}

model Wallet {
  address          String       @id
  status           WalletStatus @default(CANDIDATE)
  source           WalletSource
  score            Float?
  scoredAt         DateTime?    @map("scored_at") @db.Timestamptz(3)
  topStreak        Int          @default(0) @map("top_streak")
  missStreak       Int          @default(0) @map("miss_streak")
  isPaused         Boolean      @default(false) @map("is_paused")
  statusReason     String?      @map("status_reason")
  trackedSince     DateTime?    @map("tracked_since") @db.Timestamptz(3)
  fillsSyncedUntil DateTime?    @map("fills_synced_until") @db.Timestamptz(3)
  liveSince        DateTime?    @map("live_since") @db.Timestamptz(3)
  retiredAt        DateTime?    @map("retired_at") @db.Timestamptz(3)
  clusterId        Int?         @map("cluster_id")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  cluster   Cluster?       @relation(fields: [clusterId], references: [id])
  fills     LeaderFill[]
  state     LeaderState?
  decisions CopyDecision[]
  positions CopyPosition[]

  @@index([status])
}

model Cluster {
  id              Int       @id
  isOnline        Boolean   @default(false) @map("is_online")
  sessionId       String?   @map("session_id")
  version         String?
  maxWallets      Int?      @map("max_wallets")
  assignVersion   Int       @default(0) @map("assign_version")
  connectedAt     DateTime? @map("connected_at") @db.Timestamptz(3)
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz(3)
  lastStats       Json?     @map("last_stats")

  wallets Wallet[]
}

model LeaderFill {
  id            BigInt     @id @default(autoincrement())
  walletAddress String     @map("wallet_address")
  coin          String
  tid           BigInt
  px            Decimal    @db.Decimal(30, 10)
  sz            Decimal    @db.Decimal(30, 10)
  side          String
  time          DateTime   @db.Timestamptz(3)
  startPosition Decimal    @map("start_position") @db.Decimal(30, 10)
  dir           String
  closedPnl     Decimal    @map("closed_pnl") @db.Decimal(30, 10)
  fee           Decimal    @db.Decimal(30, 10)
  oid           BigInt
  hash          String
  crossed       Boolean
  twapId        BigInt?    @map("twap_id")
  isLiquidation Boolean    @default(false) @map("is_liquidation")
  source        FillSource
  clusterId     Int?       @map("cluster_id")
  receivedAt    DateTime   @map("received_at") @db.Timestamptz(3)
  ingestedAt    DateTime   @default(now()) @map("ingested_at") @db.Timestamptz(3)
  signalledAt   DateTime?  @map("signalled_at") @db.Timestamptz(3)

  wallet Wallet @relation(fields: [walletAddress], references: [address])

  @@unique([walletAddress, coin, tid])
  @@index([walletAddress, time])
  @@index([walletAddress, signalledAt])
}

model LeaderState {
  walletAddress String    @id @map("wallet_address")
  equityUsd     Decimal?  @map("equity_usd") @db.Decimal(20, 2)
  equityAt      DateTime? @map("equity_at") @db.Timestamptz(3)
  positions     Json?
  positionsAt   DateTime? @map("positions_at") @db.Timestamptz(3)

  wallet Wallet @relation(fields: [walletAddress], references: [address])
}

model CopyDecision {
  id             BigInt     @id @default(autoincrement())
  book           Book
  walletAddress  String     @map("wallet_address")
  coin           String
  signalKey      String     @map("signal_key")
  signalSource   String     @map("signal_source")
  action         CopyAction
  positionBefore Decimal    @map("position_before") @db.Decimal(30, 10)
  positionAfter  Decimal    @map("position_after") @db.Decimal(30, 10)
  leaderVwap     Decimal    @map("leader_vwap") @db.Decimal(30, 10)
  leaderTime     DateTime   @map("leader_time") @db.Timestamptz(3)
  receivedAt     DateTime   @map("received_at") @db.Timestamptz(3)
  decidedAt      DateTime   @map("decided_at") @db.Timestamptz(3)
  verdict        Verdict
  reason         String
  trace          Json
  targetSize     Decimal?   @map("target_size") @db.Decimal(30, 10)
  orderSize      Decimal?   @map("order_size") @db.Decimal(30, 10)

  wallet Wallet  @relation(fields: [walletAddress], references: [address])
  orders Order[]

  @@unique([book, signalKey])
  @@index([decidedAt])
  @@index([walletAddress, decidedAt])
}

model CopyPosition {
  id               BigInt    @id @default(autoincrement())
  book             Book
  walletAddress    String    @map("wallet_address")
  coin             String
  size             Decimal   @db.Decimal(30, 10)
  entryPx          Decimal?  @map("entry_px") @db.Decimal(30, 10)
  ratio            Decimal   @db.Decimal(30, 18)
  leaderSizeAtSync Decimal   @map("leader_size_at_sync") @db.Decimal(30, 10)
  allocationUsd    Decimal   @map("allocation_usd") @db.Decimal(20, 2)
  stopPx           Decimal?  @map("stop_px") @db.Decimal(30, 10)
  isOpen           Boolean   @default(true) @map("is_open")
  openedAt         DateTime  @map("opened_at") @db.Timestamptz(3)
  lastOrderAt      DateTime? @map("last_order_at") @db.Timestamptz(3)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  closeReason      String?   @map("close_reason")
  realizedPnl      Decimal   @default(0) @map("realized_pnl") @db.Decimal(20, 6)
  feesUsd          Decimal   @default(0) @map("fees_usd") @db.Decimal(20, 6)
  fundingUsd       Decimal   @default(0) @map("funding_usd") @db.Decimal(20, 6)
  leaderOpenTid    BigInt    @map("leader_open_tid")

  wallet Wallet  @relation(fields: [walletAddress], references: [address])
  orders Order[]

  @@index([book, isOpen])
  @@index([walletAddress, isOpen])
}

model Order {
  id             BigInt       @id @default(autoincrement())
  decisionId     BigInt?      @map("decision_id")
  positionId     BigInt?      @map("position_id")
  book           Book
  cloid          String       @unique
  coin           String
  isBuy          Boolean      @map("is_buy")
  size           Decimal      @db.Decimal(30, 10)
  limitPx        Decimal      @map("limit_px") @db.Decimal(30, 10)
  reduceOnly     Boolean      @map("reduce_only")
  purpose        OrderPurpose
  attempt        Int          @default(1)
  status         OrderStatus
  filledSize     Decimal      @default(0) @map("filled_size") @db.Decimal(30, 10)
  avgPx          Decimal?     @map("avg_px") @db.Decimal(30, 10)
  feeUsd         Decimal      @default(0) @map("fee_usd") @db.Decimal(20, 6)
  slippageBps    Float?       @map("slippage_bps")
  exchangeOid    BigInt?      @map("exchange_oid")
  error          String?
  submittedAt    DateTime     @map("submitted_at") @db.Timestamptz(3)
  acknowledgedAt DateTime?    @map("acknowledged_at") @db.Timestamptz(3)

  decision CopyDecision? @relation(fields: [decisionId], references: [id])
  position CopyPosition? @relation(fields: [positionId], references: [id])

  @@index([status])
}

model BookState {
  book             Book     @id
  dayStartedAt     DateTime @map("day_started_at") @db.Timestamptz(3)
  dayStartEquity   Decimal  @map("day_start_equity") @db.Decimal(20, 2)
  killSwitchActive Boolean  @default(false) @map("kill_switch_active")
  killSwitchReason String?  @map("kill_switch_reason")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
}
