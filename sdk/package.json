{
  "name": "@remora/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json -w",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.6",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
