# Host ports of the local Postgres, Redis and dashboard, for a machine whose 5432, 6379 or 8080 are taken.
# Remove these lines to use the defaults.
POSTGRES_PORT=55432
REDIS_PORT=56379
DASHBOARD_PORT=8080

# One discovery run is enough to enter or leave the tracked set, and stage one stops after 200 wallets.
# Leave STAGE_ONE_LIMIT empty for a full run, which takes up to about two hours.
SELECTION_STREAK_RUNS=1
STAGE_ONE_LIMIT=200

# How much faster the synthetic wallets of the simulator trade, for demos.
SIM_SPEED=10

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
