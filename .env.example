# Host ports of the local Postgres, Redis and dashboard, for a machine whose 5432, 6379 or 8080 are taken.
# Remove these lines to use the defaults.
POSTGRES_PORT=55432
REDIS_PORT=56379
DASHBOARD_PORT=8080

# Dev tokens of the two local collectors and the SHA-256 hashes the core accepts.
# Generate a pair with: token=$(openssl rand -hex 32); printf %s "$token" | sha256sum
CLUSTER_TOKEN_1=db785e22e25bedd6f0e18a81471c3b214b67609b4fe7d1a5d9757f182e4b4322
CLUSTER_TOKEN_2=f6435751d309c90018c2922d5e6860b10c1992ca1a6879da30e0cf8eb7f17e06
CLUSTER_TOKEN_HASHES=1:e3e0e828cd93b94a21a8874d32bc1f42bde5ca0fb931417503e59f3d06b9686f,2:7874c5143b26e38857702788650c772063680633a04e933d80ec4b4717b07b57

# One discovery run is enough to enter or leave the tracked set, and stage one stops after 200 wallets.
# Leave STAGE_ONE_LIMIT empty for a full run, which takes up to about two hours.
SELECTION_STREAK_RUNS=1
STAGE_ONE_LIMIT=200

# How much faster the synthetic wallets of the simulator trade, for demos.
SIM_SPEED=10

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
